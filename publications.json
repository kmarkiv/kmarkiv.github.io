---
layout: null
permalink: /publications.json
---
{
  "person": {
    "name": "Vikram Kamath Cannanure",
    "alternateName": ["Vikram Cannanure", "Vikram Kamath"],
    "url": {{ site.canonical | jsonify }},
    "orcid": {{ site.orcid | jsonify }},
    "googleScholar": {{ site.google_scholar | jsonify }},
    "affiliation": {{ site.affiliation | jsonify }},
    "position": {{ site.position | jsonify }}
  },
  "generated": {{ site.time | date: "%Y-%m-%d" | jsonify }},
  "count": {{ site.data.publications | size }},
  "publications": [
{%- for p in site.data.publications %}
    {
      "title": {{ p.title | jsonify }},
      "authors": {% if p.authors_list %}{{ p.authors_list | jsonify }}{% else %}[{{ p.authors | jsonify }}]{% endif %},
      "venue": {{ p.venue | jsonify }},
      "year": {{ p.year }},
      "type": {{ p.kind | default: "article" | jsonify }},
      "doi": {{ p.doi | jsonify }},
      "publisherUrl": {{ p.url | jsonify }},
      "page": {{ p.slug | prepend: "/papers/" | append: "/" | absolute_url | jsonify }},
      "preprint": {{ p.preprint | jsonify }},
      "pdf": {% if p.pdf %}{{ p.pdf | absolute_url | jsonify }}{% else %}null{% endif %},
      "bibtex": {{ p.bibtex | strip | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ]
}
